{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SudokuPad X",
  "version": "0.1.0",
  "identifier": "com.fanfront.sudokupadx",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {"label": "main", "title": "SudokuPad X", "width": 1150, "height": 800, "minWidth": 340, "minHeight": 500}
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "android": {"minSdkVersion": 24}
  }
}
