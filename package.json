{
  "name": "sudokupadx",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "wasm:build": "wasm-pack build crates/sudokupadx-web --target web --release --out-dir ../../public/wasm",
    "build:web": "npm run wasm:build && vite build",
    "dev:web": "npm run wasm:build && vite --host 127.0.0.1",
    "preview": "vite preview",
    "tauri": "tauri",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "node scripts/android-release.mjs version && node scripts/android-release.mjs sign && tauri android build --apk --target aarch64",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@tauri-apps/api": "^2.9.0",
    "vite": "^7.0.0",
    "lz-string": "^1.5.0",
    "json5": "^2.2.3"
  },
  "dependencies": {
    "@tauri-apps/plugin-opener": "^2.0.0",
    "@sudokupad/penpa-to-scl": "0.0.1-preview.2"
  }
}
